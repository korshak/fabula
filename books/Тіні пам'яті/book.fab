// Приклад проєкту книги мовою Fabula.
// Компілюється у JSON-граф; агент-письменник отримує сцени як контракти.
book "Тіні пам'яті" {
  voice: "third_person_limited";
  tense: "past";
  language: "uk";
  style_profile: "похмуре фентезі, щільна сенсорна проза, короткі внутрішні монологи";

  world "Астерія" {
    rule "Магія коштує пам'ять" {
      description: "Кожне заклинання назавжди стирає один спогад чарівника. Сильніше заклинання — дорожчий спогад.";
      severity: "hard";
    }
    rule "Технологічний рівень" {
      description: "Пізнє середньовіччя. Жодної вогнепальної зброї, друкарства чи механічних годинників.";
      severity: "hard";
    }
    rule "Мертві не повертаються" {
      description: "Некромантія не існує. Смерть у цьому світі остаточна.";
      severity: "soft";
    }
  }

  character "Аліна" {
    age: 24;
    traits: ["імпульсивна", "віддана", "цікава до небезпечного"];
    arc: "від наївності до гіркої тверезості";
    never: "зрадити близького друга без екстремальної причини";
    must_resolve: "страх глибокої води";
  }

  character "Мирон" {
    age: 41;
    traits: ["обережний", "цинічний", "потайки сентиментальний"];
    arc: "від відстороненості до жертовності";
  }

  act 1 {
    chapter 1 "Ринок" {
      scene "Артефакт" {
        pov: "Аліна";
        location: "столичний ринок, ряди лахмітників";
        time: "ранок, пізня осінь";
        tension: [0.2, 0.4, 0.7, 0.5];
        length: 900..1200;
        variants: 2;
        style_hints: ["запахи і звуки ринку", "короткий внутрішній монолог"];
        show: "Аліна вперше бачить дивний артефакт і не може відвести погляд";
        show: "продавець вимовляє ціну не грошима, а спогадом";
        forbid: "згадка вогнепальної зброї";
        forbid: "сучасний сленг";
      }
      scene "Втеча провулками" {
        pov: "Аліна";
        cast: ["Мирон"];
        location: "провулки за ринком";
        time: "той самий ранок";
        tension: [0.6, 0.8, 0.9, 0.7];
        length: 700..1000;
        show: "за Аліною женуться, вона вперше зустрічає Мирона";
        forbid: "магія без плати пам'яттю";
      }
    }
  }
}
