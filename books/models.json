{
  "default": "claude-cli",
  "providers": {
    "claude-cli": {
      "type": "claude-cli",
      "model": "opus"
    },
    "claude-api": {
      "type": "anthropic",
      "model": "claude-opus-5"
    },
    "gpt": {
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-5.2",
      "api_key_env": "OPENAI_API_KEY"
    },
    "gemini": {
      "type": "openai",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "model": "gemini-2.5-pro",
      "api_key_env": "GEMINI_API_KEY"
    },
    "ollama": {
      "type": "openai",
      "base_url": "http://localhost:11434/v1",
      "model": "llama3.3"
    }
  }
}
